<Project>

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- BL0006 warns against using Blazor's RenderTree types outside the framework. Watchious is a Blazor
         renderer, like BlazorWebView, so it has to use them. -->
    <NoWarn>$(NoWarn);BL0006</NoWarn>
  </PropertyGroup>

  <PropertyGroup Label="Versions">
    <WatchiousDotNetPackagesVersion>10.0.15</WatchiousDotNetPackagesVersion>
  </PropertyGroup>

  <!-- Only the projects that ship as packages opt in, each with its Kebechet.Watchious.* PackageId. Nothing is
       published yet: .github/scripts/pack.sh puts the packages in artifacts/packages. Version is the one all 10
       packages are published at, by .github/workflows/publish.yml (README, "Publishing"). -->
  <PropertyGroup Label="Packages">
    <Version>0.1.0-preview.1</Version>
    <Authors>Kebechet</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Kebechet/Watchious</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Kebechet/Watchious</RepositoryUrl>
    <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts/packages/</PackageOutputPath>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Apps built with Watchious.Sdk inside this repository use its sources instead of published packages. -->
  <PropertyGroup Label="Watchious.Sdk from source">
    <WatchiousRepositoryRoot>$(MSBuildThisFileDirectory)</WatchiousRepositoryRoot>
    <WatchiousUseProjectReferences>true</WatchiousUseProjectReferences>
    <WatchiousWatchOSHostDirectory>$(MSBuildThisFileDirectory)platforms/watchOS/Host/</WatchiousWatchOSHostDirectory>
  </PropertyGroup>

</Project>
