<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>WatchiousCounter</AssemblyName>
    <RootNamespace>Watchious.Samples.Counter.WatchOS</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- There is no watchOS runtime identifier. The library is compiled for the iOS simulator and its
       objects are re-tagged for the watchOS simulator by platforms/watchos/build.sh. -->
  <PropertyGroup Label="NativeAOT static library">
    <PublishAot>true</PublishAot>
    <NativeLib>Static</NativeLib>
    <PublishAotUsingRuntimePack>true</PublishAotUsingRuntimePack>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Watchious.Hosts.WatchOS\Watchious.Hosts.WatchOS.csproj" />
    <ProjectReference Include="..\Watchious.Samples.Counter\Watchious.Samples.Counter.csproj" />
  </ItemGroup>

</Project>
