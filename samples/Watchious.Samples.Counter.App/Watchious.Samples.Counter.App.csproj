<!-- The Counter sample as one project for both watches. Outside this repository the project starts with
     <Project Sdk="Watchious.Sdk"> and the two Import lines go away. -->
<Project>

  <Import Project="..\..\src\Watchious.Sdk\Sdk\Sdk.props" />

  <PropertyGroup>
    <!-- The canary CI job (.github/workflows/watchos-canary.yml) builds the app for newer .NET versions with
         -p:WatchiousAppDotNet=net11.0; the libraries stay on the repository's .NET. -->
    <WatchiousAppDotNet Condition="'$(WatchiousAppDotNet)' == ''">net10.0</WatchiousAppDotNet>
    <TargetFrameworks>$(WatchiousAppDotNet)-android</TargetFrameworks>
    <!-- A watchOS build needs a Mac: this one, or a remote one through WatchiousRemoteMac. -->
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('OSX')) Or '$(WatchiousRemoteMac)' != ''">$(TargetFrameworks);$(WatchiousAppDotNet)-watchos</TargetFrameworks>
    <!-- The desktop preview, for debugging the pages: dotnet run -f net10.0. -->
    <TargetFrameworks>$(TargetFrameworks);$(WatchiousAppDotNet)</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>Watchious.Samples.Counter.App</RootNamespace>
    <ApplicationId>com.kebechet.watchious.counter</ApplicationId>
    <ApplicationTitle>Watchious</ApplicationTitle>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <WatchiousAppFactory>Watchious.Samples.Counter.CounterApp.CreateWatchiousApp</WatchiousAppFactory>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Watchious.Samples.Counter\Watchious.Samples.Counter.csproj" />
  </ItemGroup>

  <!-- The Watchious.Messaging and Watchious.Health packages add their Swift files to the watchOS host themselves;
       from source they are listed here. -->
  <ItemGroup>
    <WatchiousWatchOSHostSource Include="..\..\src\Watchious.Messaging\watchOS\*.swift;..\..\src\Watchious.Health\watchOS\*.swift" />
  </ItemGroup>

  <!-- The Material icon the Icons page names with MaterialIcon, which a release build keeps only when it's listed. -->
  <ItemGroup>
    <WatchiousMaterialIcon Include="Hiking" />
  </ItemGroup>

  <!-- HealthKit for the Workout page. A real watch also needs a provisioning profile whose App ID has HealthKit. -->
  <PropertyGroup>
    <CodesignEntitlements>Platforms/watchOS/HealthKit.entitlements</CodesignEntitlements>
  </PropertyGroup>

  <Import Project="..\..\src\Watchious.Sdk\Sdk\Sdk.targets" />

</Project>
