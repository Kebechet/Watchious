<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>WatchiousCounter</AssemblyName>
    <RootNamespace>Watchious.Samples.Counter.watchOS</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- There is no watchOS runtime identifier. The library is compiled for iOS (simulator or device) and its
       objects are re-tagged for watchOS by platforms/watchOS/build.sh. -->
  <PropertyGroup Label="NativeAOT static library">
    <PublishAot>true</PublishAot>
    <NativeLib>Static</NativeLib>
    <PublishAotUsingRuntimePack>true</PublishAotUsingRuntimePack>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Watchious.Hosts.watchOS\Watchious.Hosts.watchOS.csproj" />
    <ProjectReference Include="..\Watchious.Samples.Counter\Watchious.Samples.Counter.csproj" />
  </ItemGroup>

</Project>
