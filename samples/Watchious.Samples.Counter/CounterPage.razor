@page "/"
@inject INavigation Navigation

<ScrollView>
    <VStack Spacing="8">
        <Label Style="TextStyle.Title">Watchious</Label>
        <Label>Count: @count</Label>
        <Button Text="+1" OnClick="() => count++" />
        <Toggle Text="Warm-up" @bind-IsOn="isWarmup" />
        @if (isWarmup)
        {
            <Label Style="TextStyle.Caption">Warm-up set</Label>
        }
        <Button Text="Summary" OnClick="ShowSummaryAsync" />
        <Button Text="Controls" OnClick="ShowControlsAsync" />
        <Button Text="Icons" OnClick="() => Navigation.GoToAsync(Routes.Icons())" />
        <Button Text="Device" OnClick="ShowDeviceAsync" />
        <Button Text="Watch APIs" OnClick="() => Navigation.GoToAsync(Routes.Apis())" />
        <Button Text="Workout" OnClick="() => Navigation.GoToAsync(Routes.Workout())" />
        <Button Text="Phone" OnClick="() => Navigation.GoToAsync(Routes.Phone())" />
        <Button Text="Network" OnClick="() => Navigation.GoToAsync(Routes.Network())" />
    </VStack>
</ScrollView>

@code {
    private int count;
    private bool isWarmup;

    private Task ShowSummaryAsync()
    {
        return Navigation.GoToAsync(Routes.Summary(count: count));
    }

    private Task ShowControlsAsync()
    {
        return Navigation.GoToAsync(Routes.Controls());
    }

    private Task ShowDeviceAsync()
    {
        return Navigation.GoToAsync(Routes.Device());
    }
}
