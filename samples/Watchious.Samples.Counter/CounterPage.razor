<ScrollView>
    <VerticalStackLayout Spacing="8">
        <Label Text="Watchious" Style="TextStyle.Title" />
        <Label Text="@($"Count: {count}")" />
        <Button Text="+1" OnClick="() => count++" />
        <Switch Text="Warm-up" @bind-IsToggled="isWarmup" />
        @if (isWarmup)
        {
            <Label Text="Warm-up set" Style="TextStyle.Caption" />
        }
    </VerticalStackLayout>
</ScrollView>

@code {
    private int count;
    private bool isWarmup;
}
