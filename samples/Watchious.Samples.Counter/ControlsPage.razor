@page "/controls"

<List>
    <HStack>
        <Image Source="watchious_logo" Width="32" Height="32" Description="Watchious logo" />
        <Label Style="TextStyle.Headline">Controls</Label>
    </HStack>
    <ProgressView Value="@progress" Text="Progress" />
    <Button Text="More progress" OnClick="AddProgress" />
    <ProgressView Text="Loading" />
    <Picker Text="Reps" Items="reps" @bind-SelectedIndex="selectedReps" />
    <Label>Reps: @reps[selectedReps]</Label>
    <TextField Placeholder="Name" @bind-Text="name" />
    <Label>Name: @name</Label>
    <DigitalCrownRotation @bind-Value="speed" From="0" Through="20" By="0.5">
        <Label Style="TextStyle.Title">@speed.ToString("0.0") km/h</Label>
        <Label Style="TextStyle.Caption">Touch, then turn the crown</Label>
    </DigitalCrownRotation>
</List>

@code {
    private readonly string[] reps = [.. Enumerable.Range(1, 20).Select(rep => rep.ToString())];
    private int selectedReps = 9;
    private string? name;
    private double progress = 0.25;
    private double speed = 8;

    private void AddProgress()
    {
        progress = Math.Min(1, progress + 0.25);
    }
}
