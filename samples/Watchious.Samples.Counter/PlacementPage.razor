@page "/placement"

@* A page that doesn't scroll: each control with VerticalOptions sits in an equal share of the screen's height. *@
<Label VerticalOptions="LayoutOptions.Start">Top</Label>
<Label HorizontalOptions="LayoutOptions.Start" VerticalOptions="LayoutOptions.Center">Left</Label>
<Label VerticalOptions="LayoutOptions.End">Bottom</Label>
