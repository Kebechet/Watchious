@page "/layout"
@inject INavigation Navigation

@* VerticalOptions in a row, HorizontalOptions in a vertical stack; the next page places content on a whole page. *@
<ScrollView>
    <VStack Spacing="6">
        <Label Style="TextStyle.Headline">Layout</Label>
        <HStack Spacing="6">
            <Image Source="watchious_logo" Width="48" Height="48" Description="Watchious logo" />
            <Label Style="TextStyle.Caption" VerticalOptions="LayoutOptions.Start">Top</Label>
            <Label Style="TextStyle.Caption" VerticalOptions="LayoutOptions.Center">Mid</Label>
            <Label Style="TextStyle.Caption" VerticalOptions="LayoutOptions.End">Low</Label>
        </HStack>
        <Button Text="Start" HorizontalOptions="LayoutOptions.Start" />
        <Button Text="Center" HorizontalOptions="LayoutOptions.Center" />
        <Button Text="End" HorizontalOptions="LayoutOptions.End" />
        <Button Text="Fill" HorizontalOptions="LayoutOptions.Fill" />
        <Button Text="Whole page" OnClick="() => Navigation.GoToAsync(Routes.Placement())" />
    </VStack>
</ScrollView>
