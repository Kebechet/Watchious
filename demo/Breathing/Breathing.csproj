<Project Sdk="Kebechet.Watchious.Sdk/0.3.0-preview.1">

  <PropertyGroup>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <!-- A watchOS build needs a Mac: this one, or a remote one through WatchiousRemoteMac=user@host. -->
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('OSX')) Or '$(WatchiousRemoteMac)' != ''">$(TargetFrameworks);net10.0-watchos</TargetFrameworks>
    <!-- The desktop preview, for debugging the pages: dotnet run -f net10.0. -->
    <TargetFrameworks>$(TargetFrameworks);net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Breathing</RootNamespace>
    <ApplicationId>com.kebechet.watchious.breathing</ApplicationId>
    <ApplicationTitle>Breathing</ApplicationTitle>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- The template's ring, painted in the app's teal on its dark teal. -->
    <WatchiousAppIcon Include="Resources/AppIcon/appicon.svg" ForegroundTintColor="#2BB3A3" BackgroundColor="#0F3F4A" />
  </ItemGroup>

</Project>
