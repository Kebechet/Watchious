<Project Sdk="Kebechet.Watchious.Sdk/0.3.1-preview.1">

  <PropertyGroup>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <!-- A watchOS build needs a Mac: this one, or a remote one through WatchiousRemoteMac=user@host. -->
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('OSX')) Or '$(WatchiousRemoteMac)' != ''">$(TargetFrameworks);net10.0-watchos</TargetFrameworks>
    <!-- The desktop preview, for debugging the pages: dotnet run -f net10.0. -->
    <TargetFrameworks>$(TargetFrameworks);net10.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DotNetSplash</RootNamespace>
    <ApplicationId>com.kebechet.watchious.dotnetsplash</ApplicationId>
    <ApplicationTitle>.NET</ApplicationTitle>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- The .NET bot on MAUI's purple, as the app's icon on both watches. -->
    <WatchiousAppIcon Include="Resources/AppIcon/dotnet_bot.svg" ForegroundSize="70%" BackgroundColor="#512BD4" />
  </ItemGroup>

</Project>
