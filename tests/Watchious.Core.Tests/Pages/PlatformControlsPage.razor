<VStack>
    <Apple.Gauge Value="250" From="40" Through="180" Text="Heart rate" CurrentValueText="250" MinimumText="40" MaximumText="180"
                 Style="Apple.GaugeStyle.Circular" />
    <Wear.TimeText Text="Run" />
    <Wear.CurvedText Text="Swipe" />
    <Wear.EdgeButton Icon="Icon.Plus" Text="Add" OnClick="() => taps++" />
    <Label>Taps: @taps</Label>
</VStack>

@code {
    private int taps;
}
