<VStack>
    <List>
        <Label>Row</Label>
    </List>
    <ProgressView Value="1.5" Text="Upload" />
    <ProgressView />
    <Picker Text="Reps" Items="reps" @bind-SelectedIndex="selected" />
    <Label>Selected: @reps[selected]</Label>
    <TextField Placeholder="Name" @bind-Text="name" />
    <Image Source="logo" Width="32" Description="Logo" />
    <Image Icon="Icon.Heart" Height="20" />
    <Image Icon="Icon.Run" AppleSymbol="figure.hiking" MaterialIcon="Hiking" />
    <Label>Name: @name</Label>
    <DigitalCrownRotation @bind-Value="speed" From="0" Through="20" By="0.5">
        <Label>Speed: @speed</Label>
    </DigitalCrownRotation>
</VStack>

@code {
    private readonly string[] reps = ["a", "b", "c\nd"];
    private int selected = 1;
    private string? name;
    private double speed = 2.5;
}
