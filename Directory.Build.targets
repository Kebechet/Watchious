<Project>

  <!-- Here, not in Directory.Build.props: these depend on IsPackable and IncludeBuildOutput, which a project file sets
       after Directory.Build.props. -->
  <PropertyGroup Condition="'$(IsPackable)' == 'true'">
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- NuGet defaults PackageVersion to Version only after this file, so here it is empty unless it is set. -->
    <PackageReleaseNotes>https://github.com/Kebechet/Watchious/releases/tag/v$([MSBuild]::ValueOrDefault('$(PackageVersion)', '$(Version)'))</PackageReleaseNotes>
  </PropertyGroup>

  <!-- Symbol packages only for the packages with assemblies: Kebechet.Watchious.Sdk and .Templates have none
       (IncludeBuildOutput false), and IncludeSymbols fails their pack with NU5017. -->
  <PropertyGroup Condition="'$(IsPackable)' == 'true' And '$(IncludeBuildOutput)' != 'false'">
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="" Visible="false" />
    <None Include="$(MSBuildProjectDirectory)/README.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

</Project>
