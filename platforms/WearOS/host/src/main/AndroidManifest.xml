<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- ITextToSpeech: from Android 11 an app sees a text-to-speech engine only when it says that it looks for one.
         The manifest merger adds this to every app that uses the host. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>
</manifest>
