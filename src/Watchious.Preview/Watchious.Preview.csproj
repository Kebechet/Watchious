<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Watchious.Preview</RootNamespace>
    <IsPackable>true</IsPackable>
    <Description>Watchious's desktop preview: runs a watch app's screens on the desktop, rendered in a browser page, so they can be debugged with a .NET debugger.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Watchious.Controls\Watchious.Controls.csproj" />
    <ProjectReference Include="..\Watchious.Essentials\Watchious.Essentials.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="wwwroot\**" LogicalName="wwwroot/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Watchious.Core.Tests" />
  </ItemGroup>

</Project>
