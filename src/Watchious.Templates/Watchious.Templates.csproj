<!-- Packs the dotnet new watchious template. -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Kebechet.Watchious.Templates</PackageId>
    <ImplicitUsings>disable</ImplicitUsings>
    <PackageType>Template</PackageType>
    <Description>Project template for Watchious watch apps: dotnet new watchious.</Description>
    <PackageTags>$(PackageTags);template;dotnet-new</PackageTags>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <EnableDefaultItems>false</EnableDefaultItems>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="content\**" Exclude="content\**\bin\**;content\**\obj\**" Pack="true" PackagePath="content\" />
  </ItemGroup>

</Project>
