<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Watchious.Hosts.watchOS</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>true</IsPackable>
    <PackageId>Kebechet.Watchious.Hosts.watchOS</PackageId>
    <Description>Watchious's watchOS host bridge: connects Watchious apps to the SwiftUI host.</Description>
    <PackageTags>$(PackageTags);swiftui;nativeaot</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Watchious.Controls\Watchious.Controls.csproj" />
    <ProjectReference Include="..\Watchious.Essentials\Watchious.Essentials.csproj" />
  </ItemGroup>

</Project>
