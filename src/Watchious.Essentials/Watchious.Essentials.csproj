<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Watchious.Essentials</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>true</IsPackable>
    <PackageId>Kebechet.Watchious.Essentials</PackageId>
    <Description>Watchious's watch APIs as C# services with MAUI Essentials' names, unified across Wear OS and watchOS: haptics, device, battery, connectivity, preferences, secure storage, app lifecycle, ambient mode, local notifications, geolocation and sensors. The hosts provide the platform implementations.</Description>
  </PropertyGroup>

</Project>
