<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Watchious</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <IsPackable>true</IsPackable>
    <Description>Watchious's Razor controls and app builder for watch apps on Wear OS and watchOS.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="$(WatchiousDotNetPackagesVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Watchious.Core\Watchious.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Watchious.Core.Tests" />
  </ItemGroup>

  <!-- The source generator for typed routes ships inside this package, so every app that uses the controls gets it. -->
  <ItemGroup>
    <ProjectReference Include="..\Watchious.SourceGenerators\Watchious.SourceGenerators.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="..\Watchious.SourceGenerators\bin\$(Configuration)\netstandard2.0\Watchious.SourceGenerators.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

</Project>
