<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>30</SupportedOSPlatformVersion>
    <RootNamespace>Watchious.Hosts.WearOS</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <WatchiousWearOSHostBuildDir>$(MSBuildThisFileDirectory)..\..\platforms\wearos\host\build\</WatchiousWearOSHostBuildDir>
  </PropertyGroup>

  <!-- The AAR also holds Kotlin internals and Compose-generated classes that use AndroidX types. The binding
       generator can resolve those only through Xamarin.AndroidX bindings, which Watchious does not use, so it
       binds a jar with just the public API (built by Gradle's watchiousBindingApi task) and the AAR ships
       unbound. -->
  <ItemGroup>
    <InputJar Include="$(WatchiousWearOSHostBuildDir)watchious-binding\watchious-host-api.jar" />
    <AndroidLibrary Include="$(WatchiousWearOSHostBuildDir)outputs\aar\host-release.aar" Bind="false" />
    <AndroidLibrary Include="$(WatchiousWearOSHostBuildDir)watchious-runtime\*.aar" Bind="false" />
    <AndroidLibrary Include="$(WatchiousWearOSHostBuildDir)watchious-runtime\*.jar" Bind="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Watchious.Controls\Watchious.Controls.csproj" />
  </ItemGroup>

</Project>
