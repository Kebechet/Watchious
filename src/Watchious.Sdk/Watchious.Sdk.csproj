<!-- Packs the Watchious MSBuild SDK, Kebechet.Watchious.Sdk (<Project Sdk="Kebechet.Watchious.Sdk/<version>">).
     Nothing is compiled: the package is the MSBuild files, the build tools, the sources of the native watchOS host, and
     the live hosts (dotnet build -t:WatchiousLive): the Wear OS one built by Gradle, the watchOS one as its sources. -->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>Kebechet.Watchious.Sdk</PackageId>
    <ImplicitUsings>disable</ImplicitUsings>
    <PackageType>MSBuildSdk</PackageType>
    <Description>The Watchious MSBuild SDK: one project for Wear OS and watchOS watch apps written in Razor.</Description>
    <PackageTags>$(PackageTags);msbuild;msbuild-sdk</PackageTags>
    <!-- The Wear OS live host is built with AndroidX, Kotlin and other Apache-2.0 libraries; the icon tool carries
         SkiaSharp (with Skia, BSD-3-Clause), HarfBuzzSharp and Svg.Skia, whose Svg.Custom is MS-PL
         (THIRD-PARTY-NOTICES.txt). -->
    <PackageLicenseExpression>MIT AND Apache-2.0 AND MS-PL AND BSD-3-Clause</PackageLicenseExpression>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <EnableDefaultItems>false</EnableDefaultItems>
    <!-- NU5128: an SDK package has no lib/ assembly on purpose. NU5129: NuGet looks for build/<package id>.props and
         .targets, but an SDK package is never a PackageReference: Sdk/Sdk.props and Sdk.targets import the build/
         files by path. NU5100: the icon tool's assemblies in appicon/ are run with dotnet, never referenced. -->
    <NoWarn>$(NoWarn);NU5128;NU5129;NU5100</NoWarn>
    <_WatchiousWearOSLiveApk>..\..\platforms\WearOS\live\build\outputs\apk\release\live-release.apk</_WatchiousWearOSLiveApk>
    <_WatchiousAppIconTool>..\..\artifacts\appicon\</_WatchiousAppIconTool>
  </PropertyGroup>

  <!-- host/watchOS/ with forward slashes: packed on Linux, host\watchOS\ gives entries like
       host/watchOS//StartRuntime.c. -->
  <ItemGroup>
    <None Include="Sdk\**" Pack="true" PackagePath="Sdk\" />
    <None Include="build\**" Pack="true" PackagePath="build\" />
    <None Include="tools\**" Pack="true" PackagePath="tools\" />
    <None Include="..\..\platforms\watchOS\Host\**" Pack="true" PackagePath="host/watchOS/" />
    <None Include="..\..\platforms\watchOS\Live\LiveRuntime.swift;..\..\platforms\watchOS\Live\Info.plist" Pack="true" PackagePath="live/watchOS/" />
    <None Include="$(_WatchiousWearOSLiveApk)" Pack="true" PackagePath="live/WearOS/watchious-live.apk" />
    <None Include="THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="" />
  </ItemGroup>

  <!-- The icon tool (Watchious.Sdk.AppIcon.targets), published by .github/scripts/pack.sh: its assemblies, the licenses,
       and the native libraries for the computers an app is built on (Windows, macOS, Linux; x64 and Arm64), without
       their debug symbols. -->
  <ItemGroup>
    <None Include="$(_WatchiousAppIconTool)*.dll;$(_WatchiousAppIconTool)*.json" Pack="true" PackagePath="appicon/" />
    <None Include="$(_WatchiousAppIconTool)notices/*" Pack="true" PackagePath="appicon/notices/" />
    <None Include="$(_WatchiousAppIconTool)runtimes/win-x64/native/*.dll" Pack="true" PackagePath="appicon/runtimes/win-x64/native/" />
    <None Include="$(_WatchiousAppIconTool)runtimes/win-arm64/native/*.dll" Pack="true" PackagePath="appicon/runtimes/win-arm64/native/" />
    <None Include="$(_WatchiousAppIconTool)runtimes/osx/native/*.dylib" Pack="true" PackagePath="appicon/runtimes/osx/native/" />
    <None Include="$(_WatchiousAppIconTool)runtimes/linux-x64/native/*.so" Pack="true" PackagePath="appicon/runtimes/linux-x64/native/" />
    <None Include="$(_WatchiousAppIconTool)runtimes/linux-arm64/native/*.so" Pack="true" PackagePath="appicon/runtimes/linux-arm64/native/" />
  </ItemGroup>

  <Target Name="_WatchiousCheckAppIconTool" BeforeTargets="_GetPackageFiles">
    <Error Condition="!Exists('$(_WatchiousAppIconTool)Watchious.AppIcon.dll')"
           Text="Watchious: the icon tool isn't published: run dotnet publish src/Watchious.AppIcon -c Release -o artifacts/appicon, or pack with .github/scripts/pack.sh, which does." />
  </Target>

  <!-- Gradle builds the Wear OS live host, signed with the repository's live key: .github/scripts/pack.sh runs it first. -->
  <Target Name="_WatchiousCheckWearOSLiveApk" BeforeTargets="_GetPackageFiles">
    <Error Condition="!Exists('$(_WatchiousWearOSLiveApk)')"
           Text="Watchious: the Wear OS live host isn't built: run ./gradlew :live:assembleRelease in platforms/WearOS, or pack with .github/scripts/pack.sh, which does." />
  </Target>

  <!-- The SDK references the Watchious packages of its own version. PackageVersion, not Version: each package is named
       after it, so -p:PackageVersion alone can't stamp another version than the packages have. The template stamps the
       same property (Watchious.Templates.csproj). -->
  <Target Name="_WatchiousPackVersion" BeforeTargets="_GetPackageFiles">
    <PropertyGroup>
      <_WatchiousVersionProps>$(IntermediateOutputPath)Watchious.Sdk.Version.props</_WatchiousVersionProps>
    </PropertyGroup>
    <WriteLinesToFile File="$(_WatchiousVersionProps)" Overwrite="true" WriteOnlyWhenDifferent="true"
                      Lines="&lt;Project&gt;;  &lt;PropertyGroup&gt;;    &lt;WatchiousVersion&gt;$(PackageVersion)&lt;/WatchiousVersion&gt;;  &lt;/PropertyGroup&gt;;&lt;/Project&gt;" />
    <ItemGroup>
      <None Include="$(_WatchiousVersionProps)" Pack="true" PackagePath="build\" />
    </ItemGroup>
  </Target>

</Project>
