<Project>

  <!-- Written when the SDK is packed: the version of the Watchious packages it references. -->
  <Import Project="$(MSBuildThisFileDirectory)Watchious.Sdk.Version.props" Condition="Exists('$(MSBuildThisFileDirectory)Watchious.Sdk.Version.props')" />

  <PropertyGroup>
    <WatchiousSdkDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)..'))</WatchiousSdkDirectory>
    <!-- A package ships the native watchOS host next to the SDK. Inside the Watchious repository,
         Directory.Build.props points these at platforms/watchOS instead. -->
    <WatchiousWatchOSHostDirectory Condition="'$(WatchiousWatchOSHostDirectory)' == ''">$(WatchiousSdkDirectory)host/watchOS/</WatchiousWatchOSHostDirectory>
    <WatchiousToolsDirectory Condition="'$(WatchiousToolsDirectory)' == ''">$(WatchiousSdkDirectory)tools/</WatchiousToolsDirectory>
    <!-- The live hosts (dotnet build -t:WatchiousLive, Watchious.Sdk.Live.targets): the Wear OS app, and the sources of
         the watchOS one, which is built on the Mac when it is started. -->
    <WatchiousWearOSLiveApk Condition="'$(WatchiousWearOSLiveApk)' == ''">$(WatchiousSdkDirectory)live/WearOS/watchious-live.apk</WatchiousWearOSLiveApk>
    <WatchiousWatchOSLiveDirectory Condition="'$(WatchiousWatchOSLiveDirectory)' == ''">$(WatchiousSdkDirectory)live/watchOS/</WatchiousWatchOSLiveDirectory>
    <!-- Without an arm64_32 slice, which NativeAOT can't build, the App Store accepts a watch app only from
         watchOS 27 (ITMS-90733). -->
    <WatchiousMinimumWatchOSVersion Condition="'$(WatchiousMinimumWatchOSVersion)' == ''">27.0</WatchiousMinimumWatchOSVersion>
    <!-- A watch app has no web assets (wwwroot), and the Razor SDK's static web assets steps fail in the per-CPU
         builds of .NET for Android. -->
    <StaticWebAssetsEnabled Condition="'$(StaticWebAssetsEnabled)' == ''">false</StaticWebAssetsEnabled>
    <!-- Like MAUI's Platforms/Android/Resources: .NET for Android otherwise takes every image under Resources/ as
         an Android resource, including the shared Resources/Images, which go to both platforms. -->
    <MonoAndroidResourcePrefix Condition="'$(MonoAndroidResourcePrefix)' == ''">Platforms\WearOS\Resources</MonoAndroidResourcePrefix>
    <!-- R8 drops the Java code a release app never calls, such as the thousands of Material icons that Image's icons
         come from: the sample's code shrinks from 52 MB to 13 MB. .NET for Android leaves it off by default, and only
         .NET for Android reads it, so it is set for every target framework (a project's own TargetFramework isn't known
         yet here). Set here, as a default the project file can change, which works as well. When it was set in
         Watchious.Sdk.BeforeCommon.targets instead, the release app shipped without the Java libraries'
         META-INF/services files and Kotlin coroutines found no main dispatcher at start-up; why wasn't found. -->
    <AndroidLinkTool Condition="'$(AndroidLinkTool)' == '' And '$(Configuration)' == 'Release'">r8</AndroidLinkTool>
    <!-- The whole app in its APK, in Debug too: .NET for Android's Fast Deployment fails on a watch, on the Wear OS
         emulator (XA0126, it can't copy its tools there) and on a watch over wireless adb (XAFD7000, device offline),
         so dotnet build -t:Run failed the first time an app was run. An app that sets it keeps its own choice. -->
    <EmbedAssembliesIntoApk Condition="'$(EmbedAssembliesIntoApk)' == ''">true</EmbedAssembliesIntoApk>
  </PropertyGroup>

</Project>
