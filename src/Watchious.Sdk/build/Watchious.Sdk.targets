<Project>

  <PropertyGroup>
    <!-- The method that creates the app, called by each platform's entry point and by the preview. -->
    <WatchiousAppFactory Condition="'$(WatchiousAppFactory)' == ''">$(RootNamespace).WatchiousProgram.CreateWatchiousApp</WatchiousAppFactory>
    <!-- A target framework without a platform (net10.0) builds the desktop preview of the app:
         dotnet run -f net10.0, or that framework picked in Visual Studio, to debug the pages. -->
    <WatchiousIsPreview Condition="'$(TargetFramework)' != '' And '$(WatchiousTargetPlatform)' == '' And '$(OutputType)' == 'Exe'">true</WatchiousIsPreview>
  </PropertyGroup>

  <!-- Single project, like MAUI: code under Platforms/WearOS and Platforms/watchOS takes part only in its own
       platform's build. -->
  <ItemGroup>
    <Compile Remove="Platforms/WearOS/**" Condition="'$(WatchiousTargetPlatform)' != 'android'" />
    <Compile Remove="Platforms/watchOS/**" Condition="'$(WatchiousTargetPlatform)' != 'watchos'" />
    <None Remove="Platforms/**" />
    <!-- The Razor SDK makes every *.json Content, and .NET for iOS copies Content into the app, which would
         include the icon set's Contents.json. -->
    <Content Remove="Platforms/**" />
  </ItemGroup>

  <!-- App images, like MAUI's: Resources/Images/*.png and *.jpg, shown with <Image Source="name" />. Wear OS gets
       them as Android drawables, watchOS as files in the app bundle (Watchious.Sdk.watchOS.targets), the preview
       next to its program. -->
  <ItemGroup Condition="'$(EnableDefaultWatchiousImages)' != 'false'">
    <WatchiousImage Include="Resources/Images/*.png;Resources/Images/*.jpg" />
    <None Remove="Resources/Images/**" />
    <Content Remove="Resources/Images/**" />
  </ItemGroup>
  <ItemGroup Condition="'$(WatchiousTargetPlatform)' == 'android'">
    <!-- .NET for Android names a resource after its path below MonoAndroidResourcePrefix. -->
    <AndroidResource Include="@(WatchiousImage)" Link="$(MonoAndroidResourcePrefix)\drawable\%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup Condition="'$(WatchiousIsPreview)' == 'true'">
    <None Include="@(WatchiousImage)" Link="Resources\Images\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- R8 (on in release builds, see Watchious.Sdk.BeforeCommon.targets) keeps only the Material icons that code names.
       Image's MaterialIcon finds its icon by name at run time, so the app lists each one it uses:
       <WatchiousMaterialIcon Include="Hiking" />. -->
  <Target Name="_WatchiousKeepMaterialIcons" BeforeTargets="_CalculateProguardConfigurationFiles"
          Condition="'$(WatchiousTargetPlatform)' == 'android' And '@(WatchiousMaterialIcon)' != ''">
    <PropertyGroup>
      <_WatchiousMaterialIconRules>$(IntermediateOutputPath)watchious-material-icons.cfg</_WatchiousMaterialIconRules>
    </PropertyGroup>
    <ItemGroup>
      <_WatchiousMaterialIconRule Include="@(WatchiousMaterialIcon->'-keep class androidx.compose.material.icons.rounded.%(Identity)Kt { *%3B }')" />
      <_WatchiousMaterialIconRule Include="@(WatchiousMaterialIcon->'-keep class androidx.compose.material.icons.automirrored.rounded.%(Identity)Kt { *%3B }')" />
    </ItemGroup>
    <WriteLinesToFile File="$(_WatchiousMaterialIconRules)" Lines="@(_WatchiousMaterialIconRule)" Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <ProguardConfiguration Include="$(_WatchiousMaterialIconRules)" />
      <FileWrites Include="$(_WatchiousMaterialIconRules)" />
    </ItemGroup>
  </Target>

  <!-- Android's rule for resource names, checked on both platforms so an image that works on one works on both. -->
  <Target Name="_WatchiousCheckImageNames" BeforeTargets="BeforeBuild" Condition="'@(WatchiousImage)' != ''">
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('%(WatchiousImage.Filename)', '^[a-z][a-z0-9_]*$'))"
           Text="Watchious: the image name '%(WatchiousImage.Filename)' must be lowercase letters, digits and _, starting with a letter, as Android requires of resource names." />
  </Target>

  <!-- Inside the Watchious repository the SDK references the source projects; a published SDK will reference the
       packages of its own version instead. -->
  <ItemGroup Condition="'$(WatchiousUseProjectReferences)' == 'true' And '$(TargetFramework)' != ''">
    <ProjectReference Include="$(WatchiousRepositoryRoot)src/Watchious.Controls/Watchious.Controls.csproj" />
    <!-- The Watchious.Controls package carries this source generator itself. -->
    <ProjectReference Include="$(WatchiousRepositoryRoot)src/Watchious.SourceGenerators/Watchious.SourceGenerators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="$(WatchiousRepositoryRoot)src/Watchious.Hosts.WearOS/Watchious.Hosts.WearOS.csproj"
                      Condition="'$(WatchiousTargetPlatform)' == 'android'" />
    <ProjectReference Include="$(WatchiousRepositoryRoot)src/Watchious.Hosts.watchOS/Watchious.Hosts.watchOS.csproj"
                      Condition="'$(WatchiousTargetPlatform)' == 'watchos'" />
    <ProjectReference Include="$(WatchiousRepositoryRoot)src/Watchious.Preview/Watchious.Preview.csproj"
                      Condition="'$(WatchiousIsPreview)' == 'true'" />
  </ItemGroup>

  <ItemGroup Condition="'$(WatchiousUseProjectReferences)' != 'true' And '$(TargetFramework)' != ''">
    <PackageReference Include="Watchious.Controls" Version="$(WatchiousVersion)" />
    <PackageReference Include="Watchious.Hosts.WearOS" Version="$(WatchiousVersion)"
                      Condition="'$(WatchiousTargetPlatform)' == 'android'" />
    <PackageReference Include="Watchious.Hosts.watchOS" Version="$(WatchiousVersion)"
                      Condition="'$(WatchiousTargetPlatform)' == 'watchos'" />
    <PackageReference Include="Watchious.Preview" Version="$(WatchiousVersion)"
                      Condition="'$(WatchiousIsPreview)' == 'true'" />
  </ItemGroup>

  <!-- The preview's Main, which runs the app in the preview page. -->
  <Target Name="_WatchiousGeneratePreviewProgram" BeforeTargets="CoreCompile" Condition="'$(WatchiousIsPreview)' == 'true'">
    <PropertyGroup>
      <_WatchiousPreviewProgram>$(IntermediateOutputPath)WatchiousPreviewProgram.g.cs</_WatchiousPreviewProgram>
    </PropertyGroup>
    <WriteLinesToFile File="$(_WatchiousPreviewProgram)"
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true"
                      Lines="// &lt;auto-generated/&gt;
// The desktop preview of the watch app, generated by Watchious.Sdk.
namespace Watchious.Generated%3B

internal static class WatchiousPreviewProgram
{
    private static global::System.Threading.Tasks.Task Main(string[] args)
    {
        return global::Watchious.Preview.WatchiousPreview.RunAsync(global::$(WatchiousAppFactory), args)%3B
    }
}" />
    <ItemGroup>
      <Compile Include="$(_WatchiousPreviewProgram)" />
      <FileWrites Include="$(_WatchiousPreviewProgram)" />
    </ItemGroup>
  </Target>

  <Import Project="$(MSBuildThisFileDirectory)Watchious.Sdk.watchOS.targets"
          Condition="'$(WatchiousTargetPlatform)' == 'watchos' And '$(WatchiousBuildsOnRemoteMac)' != 'true'" />
  <Import Project="$(MSBuildThisFileDirectory)Watchious.Sdk.watchOS.Remote.targets" Condition="'$(WatchiousBuildsOnRemoteMac)' == 'true'" />

</Project>
