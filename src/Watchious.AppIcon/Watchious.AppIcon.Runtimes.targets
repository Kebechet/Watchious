<!-- Keeps SkiaSharp's and HarfBuzzSharp's native libraries for the computers an app is built on, which the SDK package
     carries (Windows, macOS, Linux; x64 and Arm64), without their debug symbols. Their packages bring a dozen platforms
     and Windows symbols of about 100 MB each, which made every build of the tool, and of a project that references it,
     more than 1 GB. Imported by the tool and by the tests that reference it. -->
<Project>

  <PropertyGroup>
    <_WatchiousAppIconRuntimes>;win-x64;win-arm64;osx;linux-x64;linux-arm64;</_WatchiousAppIconRuntimes>
  </PropertyGroup>

  <Target Name="_WatchiousKeepShippedRuntimes" AfterTargets="ResolvePackageAssets">
    <ItemGroup>
      <RuntimeTargetsCopyLocalItems Remove="@(RuntimeTargetsCopyLocalItems)"
                                    Condition="!$(_WatchiousAppIconRuntimes.Contains(';%(RuntimeTargetsCopyLocalItems.RuntimeIdentifier);')) Or '%(RuntimeTargetsCopyLocalItems.Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

</Project>
